<!DOCTYPE html>
<html>
<head>
<style>
    body { background-color: #0f1117; color: white; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; display: flex; justify-content: center; align-items: center; height: 500px; overflow: hidden; }
    .stage { display: flex; gap: 40px; align-items: center; position: relative; }
    
    /* 記憶體區域標記 */
    .memory-label { position: absolute; top: -40px; font-size: 14px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; color: #636e72; }
    
    /* 矩陣樣式 */
    .matrix-container { display: flex; flex-direction: column; align-items: center; }
    .matrix { border: 2px solid #34495e; position: relative; background: #1a1c23; }
    .q-matrix { width: 80px; height: 120px; }
    .k-matrix { width: 120px; height: 80px; }
    
    /* 分塊 Tile */
    .tile { position: absolute; border: 1px solid rgba(255,255,255,0.2); box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 10px; transition: all 0.8s ease; }
    .tile-q { width: 80px; height: 30px; background: rgba(52, 152, 219, 0.6); left: 0; }
    .tile-k { width: 30px; height: 80px; background: rgba(231, 76, 60, 0.6); top: 0; }
    
    /* SRAM 計算區 */
    .sram { width: 150px; height: 150px; border: 4px solid #00cec9; border-radius: 12px; display: flex; flex-direction: column; justify-content: center; align-items: center; background: rgba(0, 206, 201, 0.05); position: relative; box-shadow: 0 0 20px rgba(0, 206, 201, 0.2); }
    .sram-title { color: #00cec9; font-size: 12px; margin-bottom: 10px; }
    
    /* 計算動畫核心 */
    .compute-box { width: 60px; height: 60px; border: 2px solid white; position: relative; overflow: hidden; }
    .active-tile { position: absolute; width: 100%; height: 100%; opacity: 0; }
    
    /* 動畫定義 */
    @keyframes move-q {
        0% { transform: translate(0, 0); opacity: 0; }
        20% { transform: translate(0, 45px); opacity: 1; } /* 在 HBM 內選中 */
        50% { transform: translate(180px, 45px); opacity: 1; } /* 移入 SRAM */
        80% { transform: translate(180px, 45px); opacity: 1; background: #f1c40f; } /* 計算中變色 */
        100% { transform: translate(350px, 45px); opacity: 0; } /* 寫回 HBM 並消失 */
    }

    @keyframes move-k {
        0% { transform: translate(0, 0); opacity: 0; }
        20% { transform: translate(45px, 0); opacity: 1; }
        50% { transform: translate(45px, 100px); opacity: 1; }
        80% { transform: translate(45px, 100px); opacity: 1; background: #f1c40f; }
        100% { transform: translate(45px, 250px); opacity: 0; }
    }

    .anim-q { animation: move-q 4s infinite; }
    .anim-k { animation: move-k 4s infinite; }

</style>
</head>
<body>

<div class="stage">
    <!-- HBM 區 -->
    <div class="matrix-container">
        <div class="memory-label">HBM (Main Memory)</div>
        <div style="display: flex; gap: 20px;">
            <div class="matrix q-matrix">
                <div class="tile tile-q anim-q">Q-Tile</div>
                <div style="height:30px; border-bottom:1px solid #2c3e50;"></div>
                <div style="height:30px; border-bottom:1px solid #2c3e50;"></div>
                <div style="height:30px; border-bottom:1px solid #2c3e50;"></div>
            </div>
            <div class="matrix k-matrix">
                <div class="tile tile-k anim-k">K-Tile</div>
                <div style="width:30px; height:100%; border-right:1px solid #2c3e50; float:left;"></div>
                <div style="width:30px; height:100%; border-right:1px solid #2c3e50; float:left;"></div>
                <div style="width:30px; height:100%; border-right:1px solid #2c3e50; float:left;"></div>
            </div>
        </div>
    </div>

    <!-- SRAM 區 -->
    <div class="sram">
        <div class="memory-label" style="color:#00cec9">SRAM (Fast Cache)</div>
        <div class="sram-title">Tiling Compute</div>
        <div class="compute-box">
             <!-- 這裡模擬矩陣乘法點亮 -->
             <div style="background: white; width: 100%; height: 100%; animation: pulse 4s infinite;"></div>
        </div>
        <div style="font-size: 10px; margin-top: 10px; color: #bdc3c7;">IO-Aware: No HBM Write</div>
    </div>

    <!-- 輸出結果 -->
    <div class="matrix-container">
        <div class="memory-label">Output</div>
        <div class="matrix" style="width: 60px; height: 120px; border-style: dashed; border-color: #27ae60;">
            <div style="position:absolute; bottom:10px; width:100%; text-align:center; color:#27ae60; font-size:10px;">Final O</div>
        </div>
    </div>
</div>

<style>
@keyframes pulse {
    0%, 49% { opacity: 0; }
    50%, 80% { opacity: 0.3; }
    100% { opacity: 0; }
}
</style>

</body>
</html>
